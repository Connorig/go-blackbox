# {{.ProjectName}} 项目配置(gen 风格:可运行 CRUD 全栈)

[web]
port = ":{{.Port}}"
level = "info"

[db]
driver = "sqlite"
dsn = "./{{.ProjectName}}.db"
auto_migrate = false
max_idle_conns = 10
max_open_conns = 20

[jwt]
secret = "0123456789abcdef0123456789abcdef"

[log]
out_dir = "."
level = "info"

[business]
demo_field = "hello"

[influx]
# InfluxDB 时序数据库(可选:注释即不启用)
server_url = "http://127.0.0.1:8086"
token = ""
org = ""
bucket = ""
