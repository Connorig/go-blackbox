// Package router 路由层(对齐 sg-mes-api 实战习惯):
// 一级分组 /api + 按功能模块二级分组,main 中一行挂载。
package router

import (
	"github.com/Connorig/go-blackbox/component/auth/token"
	apperr "github.com/Connorig/go-blackbox/component/error"
	"github.com/Connorig/go-blackbox/framework/web"
	"github.com/kataras/iris/v12"

	"{{.ModulePath}}/internal/router/testmycat"
)

// Route 路由入口(main 中 EnableWeb 回调里一行调用,与 sg-mes 的 setup.Route 同构)。
func Route(app *iris.Application) {
	route(app.Party("/api"))
}

// route 一级分组:按功能模块注册二级路由。
func route(root iris.Party) {
	// 测试表模块(CRUD)
	testmycat.Router(root.Party("/test-mycat"))
	// 认证模块
	authRoutes(root.Party("/auth"))
}

// authRoutes 认证路由。
func authRoutes(p iris.Party) {
	p.Post("/login", loginHandler)
	p.Get("/me", meHandler)
}

// loginHandler 登录:签发携带 scope + 组织身份的 token。
func loginHandler(ctx iris.Context) {
	access, refresh, err := apptoken.GenTokenFull(1, "dev@example.com", "user:read,user:write", 101, 10101)
	if err != nil {
		webiris.Fail(ctx, 500, apperr.CodeSystemError, "generate token failed")
		return
	}
	webiris.OK(ctx, map[string]string{"access_token": access, "refresh_token": refresh})
}

// meHandler 当前用户信息。
func meHandler(ctx iris.Context) {
	webiris.OK(ctx, map[string]interface{}{
		"id":    webiris.UserID(ctx),
		"email": webiris.UserEmail(ctx),
		"scope": webiris.DataScope(ctx),
	})
}
