// {{.ProjectName}} 由 go-blackbox 脚手架生成(配置驱动):
// 模块启停全部由 config.toml 的 [modules] 段控制(对标 Spring Boot Auto-Configuration),
// 业务只需注册自己的路由与业务逻辑。
//
// 运行:go run .  →  http://localhost:{{.Port}}(健康 /health/live,监控 /monitor)
// 端口与模块开关见 config.toml。
package main

import (
	"context"
	"log"

	appbox "github.com/Connorig/go-blackbox"
	"github.com/Connorig/go-blackbox/component/auth/token"
	apperr "github.com/Connorig/go-blackbox/component/error"
	"github.com/Connorig/go-blackbox/framework/web"
	"github.com/kataras/iris/v12"
	apploader "github.com/Connorig/go-blackbox/framework/config"
)

// AppConfig 项目配置:内嵌脚手架模块配置([modules] 段)+ 业务配置([business] 段)。
// 模块配置结构由脚手架定义,业务无需关心字段细节。
type AppConfig struct {
	apploader.Modules `mapstructure:"modules"`
	Business          BusinessConfig `mapstructure:"business"`
}

// BusinessConfig 业务自有配置段。
type BusinessConfig struct {
	DemoField string `mapstructure:"demo_field"`
}

func main() {
	err := appbox.New().Start(func(ctx context.Context, builder *appbox.ApplicationBuild) error {
		// 1. 加载配置(分层:内置默认 < 全局 gbx.toml < config.toml < 环境变量 GBX_*)
		var cfg AppConfig
		if err := builder.LoadConfig(&cfg, func(l apploader.Loader) {
			l.SetConfigFileSearcher("config", ".")    // 项目配置(子级)
			// l.SetGlobalConfigFile("gbx", "/etc/gbx") // 全局配置(父级,可选)
			l.EnableEnvSearcher("GBX")
		}); err != nil {
			return err
		}

		// 2. JWT 密钥(生产从配置/密钥管理注入,勿硬编码)
		if err := apptoken.SetSecretKey("0123456789abcdef0123456789abcdef"); err != nil {
			return err
		}

		// 3. 自动装配:按 config.toml 的 [modules] 启停
		//    (日志/认证/Web+安全基线/数据库/缓存/Mongo/Cron/Admin/监控/开放平台)
		builder.AutoConfigure(&cfg.Modules, func(app *iris.Application) {
			// 4. 业务路由(安全基线已自动挂载;认证中间件按需追加)
			app.Post("/api/v1/login", func(ctx iris.Context) {
				access, refresh, err := apptoken.GenTokenFull(1, "dev@example.com", "user:read", 101, 10101)
				if err != nil {
					webiris.Fail(ctx, 500, apperr.CodeSystemError, "generate token failed")
					return
				}
				webiris.OK(ctx, map[string]string{"access_token": access, "refresh_token": refresh})
			})
			app.Use(webiris.Auth(webiris.AuthConfig{
				Whitelist: []string{"/health", "/api/v1/login", "/monitor"},
			}))
			app.Get("/api/v1/me", func(ctx iris.Context) {
				webiris.OK(ctx, map[string]interface{}{
					"id":    webiris.UserID(ctx),
					"email": webiris.UserEmail(ctx),
					"scope": webiris.DataScope(ctx),
				})
			})
		})

		return nil
	})
	if err != nil {
		log.Fatalf("start application failed: %v", err)
	}
}
